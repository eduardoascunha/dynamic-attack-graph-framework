digraph AttackSummary {
	rankdir=LR;
	bgcolor="white";
	label="Attack Graph — Host-Level Global View";
	labelloc=t;
	fontname="Arial Bold";
	fontsize=18;
	nodesep=0.5;
	ranksep=0.9;
	node [fontname="Arial", style="filled,rounded", shape=box, penwidth=1.5];
	edge [fontname="Arial", fontsize=10, penwidth=2.0];

	subgraph cluster_legend {
		label="";
		style="filled";
		fillcolor="#F5F5F5";
		color="#999999";
		legend [shape=plaintext,fillcolor="#F5F5F5",label=<
			<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
				<TR><TD COLSPAN="4" BGCOLOR="#1A1A1A"><FONT COLOR="white" POINT-SIZE="13"><B>Host-Level Global View</B></FONT></TD></TR>
				<TR><TD COLSPAN="4" BGCOLOR="#333333"><FONT COLOR="white">Host risk (max on path)</FONT></TD></TR>
				<TR><TD BGCOLOR="#C85A54"><FONT COLOR="white">Critical &#8805;7</FONT></TD><TD BGCOLOR="#CC7A50">High &#8805;4</TD><TD BGCOLOR="#D4A574">Medium &#8805;2</TD><TD BGCOLOR="#7A9BAE"><FONT COLOR="white">Low &lt;2</FONT></TD></TR>
				<TR><TD COLSPAN="4" BGCOLOR="#333333"><FONT COLOR="white">Special hosts</FONT></TD></TR>
				<TR><TD BGCOLOR="#DCDCDC" COLSPAN="2">Origin (ellipse)</TD><TD BGCOLOR="#C8979E" COLSPAN="2">Goal (ellipse)</TD></TR>
				<TR><TD COLSPAN="4" ALIGN="LEFT"><I>Arrows = lateral movement; label shows max risk &amp; path count</I></TD></TR>
			</TABLE>>];
	}

	"apiServer" [label=<<B>apiServer</B><BR/><FONT POINT-SIZE="10">priv: jetty</FONT><BR/><FONT POINT-SIZE="10">risk: 3.37</FONT><BR/><FONT POINT-SIZE="9">CVE-2026-12611, CVE-2026-19203 +1</FONT>>,shape=ellipse,fillcolor="#C8979E"];
	"authServer" [label=<<B>authServer</B><BR/><FONT POINT-SIZE="10">priv: keycloak</FONT><BR/><FONT POINT-SIZE="10">risk: 3.25</FONT>>,shape=ellipse,fillcolor="#C8979E"];
	"cacheServer" [label=<<B>cacheServer</B><BR/><FONT POINT-SIZE="10">priv: memcached</FONT><BR/><FONT POINT-SIZE="10">risk: 3.25</FONT>>,shape=ellipse,fillcolor="#C8979E"];
	"dbServer" [label=<<B>dbServer</B><BR/><FONT POINT-SIZE="10">priv: postgresql</FONT><BR/><FONT POINT-SIZE="10">risk: 3.25</FONT>>,shape=ellipse,fillcolor="#C8979E"];
	"mqServer" [label=<<B>mqServer</B><BR/><FONT POINT-SIZE="10">priv: rabbitmq</FONT><BR/><FONT POINT-SIZE="10">risk: 0.00</FONT>>,shape=ellipse,fillcolor="#C8979E"];
	"portalServer" [label=<<B>portalServer</B><BR/><FONT POINT-SIZE="10">priv: tomcat</FONT><BR/><FONT POINT-SIZE="10">risk: 3.66</FONT><BR/><FONT POINT-SIZE="9">CVE-2023-24998</FONT>>,shape=ellipse,fillcolor="#C8979E"];

	"apiServer" -> "authServer" [label="risk: 3.25\n(12 paths)",color="#D4A574"];
	"apiServer" -> "cacheServer" [label="risk: 3.25\n(36 paths)",color="#D4A574"];
	"apiServer" -> "dbServer" [label="risk: 3.25\n(130 paths)",color="#D4A574"];
	"apiServer" -> "mqServer" [label="risk: 0.00\n(9 paths)",color="#7A9BAE"];
	"portalServer" -> "apiServer" [label="risk: 3.37\n(85 paths)",color="#D4A574"];
}
