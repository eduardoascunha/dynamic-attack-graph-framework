		fillcolor="#F5F5F5";

		legend_info [shape=plaintext,label=<
			<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
				<TR><TD COLSPAN="3" BGCOLOR="#1a1a1a"><FONT COLOR="white" POINT-SIZE="14"><B>RISK ANALYSIS SUMMARY</B></FONT></TD></TR>
				<TR><TD ALIGN="LEFT"><B>Total Attack Paths:</B></TD><TD COLSPAN="2">1373</TD></TR>
				<TR><TD ALIGN="LEFT"><B>Unique CVEs:</B></TD><TD COLSPAN="2">19</TD></TR>
				<TR><TD ALIGN="LEFT"><B>Maximum Risk:</B></TD><TD COLSPAN="2"><FONT COLOR="#C85A54"><B>0.36/10</B></FONT></TD></TR>
				<TR><TD ALIGN="LEFT"><B>Average Risk:</B></TD><TD COLSPAN="2"><B>0.02/10</B></TD></TR>
				<TR><TD ALIGN="LEFT"><B>Coverage:</B></TD><TD COLSPAN="2">100.0%</TD></TR>

				<TR><TD COLSPAN="3" BGCOLOR="#1a1a1a"><FONT COLOR="white" POINT-SIZE="12"><B>NODE COLORS (Colorblind-Friendly)</B></FONT></TD></TR>
				<TR><TD BGCOLOR="#D97066" WIDTH="120"><B>KEV</B></TD><TD COLSPAN="2" ALIGN="LEFT">CISA Known Exploited Vulnerability (active exploitation)</TD></TR>
				<TR><TD BGCOLOR="#CC7A50"><B>Critical</B></TD><TD COLSPAN="2" ALIGN="LEFT">Critical Severity: CVSS ≥ 9.0</TD></TR>
				<TR><TD BGCOLOR="#D4A574"><B>High</B></TD><TD COLSPAN="2" ALIGN="LEFT">High Severity: CVSS ≥ 7.0</TD></TR>
				<TR><TD BGCOLOR="#E8D5B7"><B>Medium</B></TD><TD COLSPAN="2" ALIGN="LEFT">Medium Severity: CVSS ≥ 4.0</TD></TR>
				<TR><TD BGCOLOR="#D8D8D8"><B>Low</B></TD><TD COLSPAN="2" ALIGN="LEFT">Low Severity: CVSS &lt; 4.0</TD></TR>
				<TR><TD BGCOLOR="#C8979E"><B>Goal</B></TD><TD COLSPAN="2" ALIGN="LEFT">Attacker Goal / Final Objective</TD></TR>
				<TR><TD BGCOLOR="#B8A9C9"><B>STRIDE</B></TD><TD COLSPAN="2" ALIGN="LEFT">STRIDE Threat Model Vulnerability</TD></TR>
				<TR><TD BGCOLOR="#9DB4C0"><B>Rule</B></TD><TD COLSPAN="2" ALIGN="LEFT">AND/OR Logic Rule</TD></TR>
				<TR><TD BGCOLOR="#FFFFFF"><B>Fact</B></TD><TD COLSPAN="2" ALIGN="LEFT">Infrastructure Fact (no CVE)</TD></TR>

				<TR><TD COLSPAN="3" BGCOLOR="#1a1a1a"><FONT COLOR="white" POINT-SIZE="12"><B>NODE SHAPES</B></FONT></TD></TR>
				<TR><TD><B>Diamond</B></TD><TD COLSPAN="2" ALIGN="LEFT">OR Node (reachable state or goal)</TD></TR>
				<TR><TD><B>Ellipse</B></TD><TD COLSPAN="2" ALIGN="LEFT">AND Node (inference rule)</TD></TR>
				<TR><TD><B>Box</B></TD><TD COLSPAN="2" ALIGN="LEFT">Leaf (vulnerability or fact)</TD></TR>

				<TR><TD COLSPAN="3" BGCOLOR="#1a1a1a"><FONT COLOR="white" POINT-SIZE="12"><B>EDGE COLORS</B></FONT></TD></TR>
				<TR><TD><FONT COLOR="#C85A54"><B>Dark Coral</B></FONT></TD><TD COLSPAN="2" ALIGN="LEFT">High Risk ≥ 7.0</TD></TR>
				<TR><TD><FONT COLOR="#CC7A50"><B>Burnt Orange</B></FONT></TD><TD COLSPAN="2" ALIGN="LEFT">Medium-High Risk ≥ 4.0</TD></TR>
				<TR><TD><FONT COLOR="#D4A574"><B>Tan</B></FONT></TD><TD COLSPAN="2" ALIGN="LEFT">Medium Risk ≥ 2.0</TD></TR>
				<TR><TD><FONT COLOR="#7A9BAE"><B>Steel Blue</B></FONT></TD><TD COLSPAN="2" ALIGN="LEFT">Low Risk &lt; 2.0</TD></TR>
				<TR><TD COLSPAN="3" ALIGN="LEFT"><I>Label format: "risk: X.X (N paths)"</I></TD></TR>

				<TR><TD COLSPAN="3" BGCOLOR="#1a1a1a"><FONT COLOR="white" POINT-SIZE="12"><B>METRICS</B></FONT></TD></TR>
				<TR><TD><B>Risk Score</B></TD><TD COLSPAN="2" ALIGN="LEFT">Risk rating (0-10): EPSS × CVSS × KEV × Criticality</TD></TR>
				<TR><TD><B>CVSS</B></TD><TD COLSPAN="2" ALIGN="LEFT">Common Vulnerability Scoring System v3.1 (0-10)</TD></TR>
				<TR><TD><B>EPSS</B></TD><TD COLSPAN="2" ALIGN="LEFT">Exploit Prediction Scoring System (0-1): exploitation probability</TD></TR>
				<TR><TD><B>KEV</B></TD><TD COLSPAN="2" ALIGN="LEFT">CISA Known Exploited Vulnerabilities: 1.5× multiplier</TD></TR>
			</TABLE>
		>];
